# Environment files are intentionally tracked per project requirements.

# Node dependencies (keep frontend/backend deps out of git history)
node_modules/
fe/node_modules/
be/node_modules/

# Build artifacts
fe/.next/
fe/out/
fe/.turbo/
fe/.vercel/
fe/.cache/
fe/.swc/
